# Publish only application/detector source, production assets and license notices.
# New root files/directories are local unless explicitly allowed here.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/VERSION.txt
!/src/
!/qml/
!/assets/
!/third_party/
!/licenses/

# Keep documentation and generated/private files out of allowed source trees.
*.md
!LICENSE.md
node_modules/
__pycache__/
.pytest_cache/
.DS_Store
.env
.env.*
*.py[cod]
*.log
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.tar
*.tar.gz
*.zip
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.json
*.tsbuildinfo
*.swp
*.swo
